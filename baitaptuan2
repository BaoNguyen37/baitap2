using System;
using System.Collections.Generic;
using System.Linq;

class Program
{
    static void Main(string[] args)
    {
        List<Student> students = new List<Student>
        {
            new Student { Id = 001, Name = "An", Age = 15 },
            new Student { Id = 002, Name = "Bình", Age = 17 },
            new Student { Id = 003, Name = "Anh", Age = 18 },
            new Student { Id = 004, Name = "Cuong", Age = 16 },
            new Student { Id = 005, Name = "Dũng", Age = 19 }
        };

        // a. 
        Console.WriteLine("a. Danh sach hoc sinh:");
        foreach (var s in students)
        {
            Console.WriteLine($"{s.Id} - {s.Name} - {s.Age}");
        }

        // b. 
        Console.WriteLine("\nb. Hoc sinh tu 15 den 18 tuoi:");
        var resultB = students.Where(s => s.Age >= 15 && s.Age <= 18);

        foreach (var s in resultB)
        {
            Console.WriteLine($"{s.Id} - {s.Name} - {s.Age}");
        }

        // c. 
        Console.WriteLine("\nc. Hoc sinh ten bat dau bang A:");
        var resultC = students.Where(s => s.Name.StartsWith("A"));

        foreach (var s in resultC)
        {
            Console.WriteLine($"{s.Id} - {s.Name} - {s.Age}");
        }

        // d. 
        Console.WriteLine("\nd. Tong tuoi:");
        int totalAge = students.Sum(s => s.Age);
        Console.WriteLine(totalAge);

        // e. 
        Console.WriteLine("\ne. Hoc sinh lon tuoi nhat:");
        int maxAge = students.Max(s => s.Age);
        var oldest = students.First(s => s.Age == maxAge);

        Console.WriteLine($"{oldest.Id} - {oldest.Name} - {oldest.Age}");

        // f. 
        Console.WriteLine("\nf. Sap xep tuoi tang dan:");
        var resultF = students.OrderBy(s => s.Age);

        foreach (var s in resultF)
        {
            Console.WriteLine($"{s.Id} - {s.Name} - {s.Age}");
        }

        Console.ReadLine();
    }
}
